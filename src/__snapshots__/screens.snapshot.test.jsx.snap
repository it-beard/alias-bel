exports[`снапшоты экранаў > rules (cyr) 1`] = `
<dialog
  aria-label="Правілы гульні"
  aria-modal="true"
  class="sheet"
  open=""
>
  <div
    class="sheet__backdrop"
  />
  <div
    class="sheet__body"
  >
    <div
      aria-hidden="true"
      class="sheet__grip"
    />
    <h2
      class="sheet__title"
    >
      Правілы
    </h2>
    <ol
      class="rules"
    >
      <li>
        Гульцы дзеляцца на каманды (ад 1 да 5). Каманды тлумачаць словы па чарзе.
      </li>
      <li>
        Адзін гулец бярэ тэлефон і тлумачыць слова з экрана, астатнія ў камандзе адгадваюць.
      </li>
      <li>
        Нельга называць аднакаранёвыя словы, перакладаць слова на іншую мову і паказваць яго жэстамі. 
        Можна тлумачыць сінонімамі, антонімамі, апісаннем і асацыяцыямі.
      </li>
      <li>
        Адгадалі — націсніце 
        <b>
          Адгадана
        </b>
         (ці свайпніце направа): +1 ачко. Не ведаеце слова — 
        <b>
          Пас
        </b>
         (свайп налева): −1 ачко, калі ўключаны штраф.
      </li>
      <li>
        Раунд доўжыцца зададзены час. Пасля сігналу можна дагуляць апошняе слова, калі правіла ўключана.
      </li>
      <li>
        Пасля раунда паказваецца спіс словаў — спрэчныя адзнакі можна выправіць націскам.
      </li>
      <li>
        Гульня сканчаецца, калі нейкая каманда набірае мэтавую колькасць ачкоў; круг дагульваецца да канца, 
        каб ва ўсіх была роўная колькасць раундаў.
      </li>
    </ol>
    <button
      class="btn btn--primary"
      type="button"
    >
      Зразумела
    </button>
  </div>
</dialog>
`;

exports[`снапшоты экранаў > rules (lat) 1`] = `
<dialog
  aria-label="Praviły hulni"
  aria-modal="true"
  class="sheet"
  open=""
>
  <div
    class="sheet__backdrop"
  />
  <div
    class="sheet__body"
  >
    <div
      aria-hidden="true"
      class="sheet__grip"
    />
    <h2
      class="sheet__title"
    >
      Praviły
    </h2>
    <ol
      class="rules"
    >
      <li>
        Hulcy dzielacca na kamandy (ad 1 da 5). Kamandy tłumačać słovy pa čarzie.
      </li>
      <li>
        Adzin hulec biare telefon i tłumačyć słova z ekrana, astatnija ŭ kamandzie adhadvajuć.
      </li>
      <li>
        Nielha nazyvać adnakaraniovyja słovy, pierakładać słova na inšuju movu i pakazvać jaho žestami. 
        Možna tłumačyć sinonimami, antonimami, apisanniem i asacyjacyjami.
      </li>
      <li>
        Adhadali — nacisnicie 
        <b>
          Adhadana
        </b>
         (ci svajpnicie naprava): +1 ačko. Nie viedajecie słova — 
        <b>
          Pas
        </b>
         (svajp naleva): −1 ačko, kali ŭklučany štraf.
      </li>
      <li>
        Raund doŭžycca zadadzieny čas. Pasla sihnału možna dahulać apošniaje słova, kali praviła ŭklučana.
      </li>
      <li>
        Pasla raunda pakazvajecca spis słovaŭ — sprečnyja adznaki možna vypravić naciskam.
      </li>
      <li>
        Hulnia skančajecca, kali niejkaja kamanda nabiraje metavuju kolkasć ačkoŭ; kruh dahulvajecca da kanca, 
        kab va ŭsich była roŭnaja kolkasć raundaŭ.
      </li>
    </ol>
    <button
      class="btn btn--primary"
      type="button"
    >
      Zrazumieła
    </button>
  </div>
</dialog>
`;

